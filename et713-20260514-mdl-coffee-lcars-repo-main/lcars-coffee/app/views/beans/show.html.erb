<% content_for :title, "LCARS // #{@bean.product_name}" %>
<% content_for :subtitle, "Bean Specification // LCARS 2380" %>

<div class="panel-label"><%= bean_designation(@bean) %> // Bean Specification</div>
<div class="panel-divider"></div>

<div class="panel-section" style="border-left-color: var(--lcars-<%= @bean.bean_type == 'Robusta' ? 'rust' : @bean.bean_type == 'Liberica' ? 'violet' : @bean.bean_type == 'Excelsa' ? 'teal' : 'amber' %>);">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 16px;">
    <div>
      <div style="font-size: 24px; font-weight: 700; color: var(--lcars-cream); text-transform: uppercase; letter-spacing: 1.5px; line-height: 1.1;">
        <%= @bean.product_name %>
      </div>
      <div style="font-family: 'Share Tech Mono', monospace; font-size: 11px; color: var(--lcars-text-dim); letter-spacing: 1px; margin-top: 4px;">
        <%= bean_designation(@bean) %>
      </div>
    </div>
    <span class="bean-type-pill t-<%= type_class(@bean.bean_type) %>"><%= @bean.bean_type %></span>
  </div>

  <dl class="modal-spec">
    <dt>Variety</dt><dd><%= @bean.bean_type %></dd>
    <dt>Unit Price</dt><dd><%= sprintf("%.2f", @bean.price) %> cr</dd>
    <dt>Stock</dt><dd><%= @bean.quantity %> units</dd>
    <dt>Total Value</dt><dd><%= sprintf("%.2f", @bean.price * @bean.quantity) %> cr</dd>
    <% if @bean.supplier %>
      <dt>Supplier</dt><dd><%= link_to @bean.supplier.name, supplier_path(@bean.supplier), style: "color: var(--lcars-amber);" %></dd>
      <dt>Origin</dt><dd><%= @bean.supplier.city %>, <%= @bean.supplier.state %></dd>
    <% end %>
    <dt>Created</dt><dd><%= @bean.created_at.strftime("%Y.%m.%d %H:%M") %></dd>
  </dl>

  <div style="border-top: 1px dashed #444; padding-top: 14px; margin-top: 14px;">
    <div style="color: var(--lcars-amber); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 8px;">// Tasting Notes</div>
    <div style="color: var(--lcars-cream); font-family: 'Share Tech Mono', monospace; font-size: 13px; line-height: 1.6;">
      <%= @bean.description %>
    </div>
  </div>
</div>

<div class="action-row">
  <%= link_to "Edit", edit_bean_path(@bean), class: "lcars-btn b-orange" %>
  <%= link_to "Back to Manifest", beans_path, class: "lcars-btn" %>
  <%= button_to "Delete", @bean, method: :delete,
        form: { data: { turbo_confirm: "Decommission this bean from inventory?" } },
        class: "lcars-btn b-red" %>
</div>