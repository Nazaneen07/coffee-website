<% content_for :title, "LCARS // Supplier Roster" %>
<% content_for :subtitle, "Trade Network // LCARS 2380" %>

<div class="panel-label">Stardate <%= stardate %> // Supplier Roster</div>
<div class="panel-divider"></div>

<div class="action-row">
  <%= link_to "+ New Supplier", new_supplier_path, class: "lcars-btn b-blue" %>
  <%= link_to "Beans", beans_path, class: "lcars-btn b-orange" %>
</div>

<% if @suppliers.any? %>
  <div class="bean-list">
    <% @suppliers.each do |supplier| %>
      <% sku_count = supplier.beans.count %>
      <% total_stock = supplier.beans.sum(:quantity) %>
      <% total_value = supplier.beans.sum("price * quantity") %>
      <%= link_to supplier_path(supplier), class: "bean-card is-supplier" do %>
        <div class="bean-id">
          <%= supplier_designation(supplier) %> // <%= supplier.city %>, <%= supplier.state %>
        </div>
        <div class="bean-name"><%= supplier.name %></div>
        <span class="bean-type-pill" style="background: var(--lcars-violet);"><%= sku_count %> SKU</span>
        <div class="bean-desc">
          <%= supplier.address %> · <%= supplier.email %> · <%= supplier.phone %>
        </div>
        <div class="bean-meta">
          <div class="bean-price">
            <span class="bean-price-currency">stk</span><%= number_with_delimiter(total_stock) %>
          </div>
          <div class="bean-qty">
            <span>cr <%= number_with_delimiter(total_value.to_i) %> value</span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <div class="blink">> NO SUPPLIERS REGISTERED</div>
    <div style="margin-top: 16px;">
      <%= link_to "+ Register First Supplier", new_supplier_path, class: "lcars-btn b-blue" %>
    </div>
  </div>
<% end %>